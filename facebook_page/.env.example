# ══════════════════════════════════════════════════════
# Oybit — Environment Variables
# Copy to .env and fill in real values before deploying
# ══════════════════════════════════════════════════════

# ── Core ──
DATABASE_URL=sqlite:///./oybit_dev.db
# DATABASE_URL=postgresql://user:pass@host:5432/oybit   # Production
SECRET_KEY=change-this-in-production
FRONTEND_URL=http://localhost:3000

# ── AI ──
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=meta-llama/llama-4-scout:free
OPENROUTER_DEEP_MODEL=anthropic/claude-sonnet-4

# ── MiroFish Sidecar (swarm intelligence simulation) ──
MIROFISH_API_URL=http://localhost:5001
ZEP_API_KEY=                          # Free at https://app.getzep.com/
USE_ZEP_CLOUD=true
MIROFISH_AGENT_COUNT=20

# ── Meta (Instagram + Facebook) ──
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_PERSONAL_TOKEN=
INSTAGRAM_PERSONAL_USER_ID=
INSTAGRAM_BRAND_TOKEN=
INSTAGRAM_BRAND_USER_ID=
FACEBOOK_PAGE_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_PERSONAL_TOKEN=
FACEBOOK_TARGET_GROUPS=python,javascript,startups
META_GRAPH_API_VERSION=v19.0

# ── LinkedIn ──
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=
LINKEDIN_TARGET_GROUPS=python,software

# ── YouTube & Pinterest ──
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# ── Telegram ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_AHMAD_CHAT_ID=

# ── Reddit ──
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# ── Growth ──
FOLLOW_STRATEGY_ENABLED=false
MAX_FOLLOWS_PER_DAY=3

# ── Webhooks ──
NYVORA_INTERNAL_WEBHOOK_SECRET=

# ── Cultural Calendar ──
EXAM_PERIOD_START=
EXAM_PERIOD_END=

# ── Waitlist ──
OYBIT_WAITLIST_ENABLED=true

# ── Workers ──
MIROFISH_RUN_HOUR=5
FEEDBACK_RUN_DAY=sunday
FEEDBACK_RUN_HOUR=2
TOKEN_REFRESH_INTERVAL=7200

# ── Paths ──
PERSONA_DIR=./data/personas/ahmad
RENDER_OUTPUT_DIR=./tmp/oybit_renders
